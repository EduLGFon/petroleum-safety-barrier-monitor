# ══════════════════════════════════════════════════════════════════════════
# API CONFIGURATION — Seacrest Monitor de Barreiras
# ══════════════════════════════════════════════════════════════════════════

# "mock" (default) uses the deterministic in-memory generator (lib/data.ts).
# "http" switches every data call to the real API routes under app/api/,
# backed by Postgres — see lib/api.ts httpAdapter and db/schema.sql.
NEXT_PUBLIC_API_MODE=mock

# Only used when NEXT_PUBLIC_API_MODE=http. Root URL to fetch from, no
# trailing slash. The API routes in this repo (app/api/barriers,
# app/api/barriers/[id], app/api/kpi) live in this same Next.js app, so for
# local dev this is usually just your dev server's own origin:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Point it at a different origin only if the API is deployed separately.
# Endpoints expected:
#   GET   /api/barriers?<query>        -> BarriersResponse (lib/wireTypes.ts)
#   GET   /api/barriers/:id            -> WireBarrier
#   GET   /api/kpi?locationId=<n>      -> WireKpiSnapshot
#   PATCH /api/barriers/:id/status     -> WireBarrier (bonus write path)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ══════════════════════════════════════════════════════════════════════════
# DATABASE — required whenever NEXT_PUBLIC_API_MODE=http
# ══════════════════════════════════════════════════════════════════════════

# Standard libpq connection string. Read by lib/server/db.ts (the app) and
# scripts/migrate.ts / scripts/seed.ts (one-off setup scripts) — see
# docs/DATABASE.md for the full setup walkthrough.
DATABASE_URL=postgres://user:password@localhost:5432/seacrest_barreiras
