# BRANDING - operator name shown in titles, headers, exports
# empty = unbranded output
COMPANY_NAME="My business"


# API CONFIGURATION
# mock = in-memory data; http = real API (needs DATABASE_URL)
PUBLIC_API_MODE=mock
# root URL for a separate API host; empty = page origin
PUBLIC_API_BASE_URL=


# LOGGING
# LOG_LEVEL: debug|info|warn|error (default info)
# LOG_LEVEL=info
# LOG_FORMAT: text|json (default text)
# LOG_FORMAT=text


# DATABASE
# host connection string
DATABASE_URL=postgres://barrier:barrier@localhost:5432/barreiras?sslmode=disable
# container connection string
# DATABASE_URL_DOCKER=postgres://barrier:barrier@db:5432/barreiras?sslmode=disable
# bundled db service init (uncomment to override)
# POSTGRES_DB=barreiras
# POSTGRES_USER=barrier
# POSTGRES_PASSWORD=barrier
# POSTGRES_PORT=5432


# ADMIN AUTH - bearer token for ops scripts; dashboard users use sessions
# ADMIN_TOKEN=


# FRACTTAL - safe-harbor capture
# FRACTTAL_KEY=
# FRACTTAL_SECRET=
# FRACTTAL_BASE_URL=https://app.fracttal.com/api
# on-demand raw panel (admin-only, requires DEV=true)
DEV=false


# OPS NOTIFICATION - failed sync runs
# MAIL_USER/MAIL_PASS accepted as aliases for OPS_SMTP_USER/PASS
# OPS_SMTP_HOST=
# OPS_EMAIL_TO=ops-team@example.com
# OPS_SMTP_PORT=587
# OPS_SMTP_USER=
# OPS_SMTP_PASS=
# OPS_EMAIL_FROM=barrier-monitor-ops@example.com


# ALERT PROVIDER - upstream delivery
# ALERT_PROVIDER_BASE_URL=
# ALERT_PROVIDER_TOKEN=
# ALERT_PROVIDER_COMPANY_ID=1


# ALERT DIGEST / POLLING
# ALERTS_POLL_SECONDS=900
# APP_BASE_URL=
# FRACTTAL_POLL_SECONDS=300
# FRACTTAL_SYNC_ITEM_TYPE=2
# FRACTTAL_SYNC_MAX_PAGES=200
# FRACTTAL_SYNC_WORK_MAX_PAGES=5
# FRACTTAL_RATE_PER_MIN=180
# FRACTTAL_RATE_MAX_PER_MIN=190
# FRACTTAL_RATE_MIN_PER_MIN=80
# FRACTTAL_RATE_BURST=10
# FRACTTAL_FETCH_CONCURRENCY=4
# FRACTTAL_WORK_OPEN_ONLY=1


# SSO - Microsoft Entra ID (OIDC, optional)
# AUTH_SSO_ENABLED=false
# AUTH_LOCAL_ENABLED=true
# AUTH_ENTRA_TENANT_ID=
# AUTH_ENTRA_CLIENT_ID=
# AUTH_ENTRA_CLIENT_SECRET=
# AUTH_ENTRA_PRIVATE_KEY_PATH=./secrets/entra.key
# AUTH_ENTRA_CERTIFICATE_PATH=./secrets/entra.crt
# AUTH_SSO_FORCE_ACCOUNT_PICKER=true
# AUTH_SSO_FLOW_TTL_SECONDS=600
# AUTH_SSO_CLOCK_TOLERANCE_SECONDS=60
# AUTH_SSO_HTTP_TIMEOUT_MS=10000
# AUTH_SSO_FRONTCHANNEL_LOGOUT_ENABLED=false
