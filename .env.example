# ══════════════════════════════════════════════════════════════════════════
# BRANDING — operator name shown in titles, headers and export files
# ══════════════════════════════════════════════════════════════════════════

# Company name displayed across the UI and export files. Leave empty for
# unbranded output. Example:
COMPANY_NAME="My business"

# ══════════════════════════════════════════════════════════════════════════
# API CONFIGURATION — Monitor de Barreiras
# ══════════════════════════════════════════════════════════════════════════

# "mock" (default) uses the deterministic in-memory generator (lib/data.ts).
# "http" switches every data call to the real API routes under routes/api/,
# backed by Postgres — see lib/api.ts httpAdapter and db/schema.sql.
# Either way the UI requires a login: pages and data APIs only serve valid
# sessions (Postgres-backed), so local UI work needs DATABASE_URL even for
# mock data. Anonymous visitors get 404 everywhere except /login.
PUBLIC_API_MODE=mock

# Only used when PUBLIC_API_MODE=http. Root URL to fetch from, no
# trailing slash. Leave EMPTY to use the page's own origin (recommended):
# the API routes live in this same Fresh app, so the browser fetches /api/*
# same-origin no matter which port dev/start picked. Set it explicitly only
# when the API is deployed separately (that origin then needs CORS headers).
PUBLIC_API_BASE_URL=

# ══════════════════════════════════════════════════════════════════════════
# DATABASE — required whenever PUBLIC_API_MODE=http
# ══════════════════════════════════════════════════════════════════════════

# Standard libpq connection string. Read by lib/server/db.ts (the app) and
# scripts/migrate.ts / scripts/seed.ts (one-off setup scripts) — see
# docs/DATABASE.md for the full setup walkthrough.
DATABASE_URL=postgres://user:password@localhost:5432/barreiras

# ══════════════════════════════════════════════════════════════════════════
# ADMIN AUTH — token for scripts plus cookie sessions for dashboard users
# ══════════════════════════════════════════════════════════════════════════

# Bearer token for ops scripts on admin routes:
# Authorization: Bearer <ADMIN_TOKEN>. Dashboard users log in with email +
# password instead (POST /api/auth/login sets an HttpOnly session cookie,
# 12h TTL). Admin routes accept either; dashboard data reads require a
# session or the token (anonymous callers get 404, dead sessions get 401).
# Fail-closed: no valid credential means denial, never data.
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# First login: POST /api/users on an empty users table creates the first
# admin without auth, or run:
#   deno run -A --env-file=.env scripts/create-admin.ts --email a@x --password 'long-enough-1234'

# ══════════════════════════════════════════════════════════════════════════
# FRACTTAL — safe-harbor capture (P2 spike, production-only tenant)
# ══════════════════════════════════════════════════════════════════════════

# OAuth2 client-credentials pair from Fracttal One -> Settings -> API
# Connections -> OAuth Consumers. NEVER commit real values; consumed only by
# scripts/fracttal-capture.ts (read-only, bounded, anonymizes before saving).
# FRACTTAL_KEY=
# FRACTTAL_SECRET=

# Data API base (no trailing slash). Defaults to https://app.fracttal.com/api
# when unset — see docs/FRACTTAL.md for endpoints, limits and mapping.
# FRACTTAL_BASE_URL=https://app.fracttal.com/api

# ══════════════════════════════════════════════════════════════════════════
# OPS NOTIFICATION — sync failures must never go silent (P3)
# ══════════════════════════════════════════════════════════════════════════

# Every failed sync run is logged to stderr automatically (console channel is
# always on). Set these two to also receive an ops email with the scope,
# run id, and error note — see docs/FRACTTAL.md "Sync service".
# OPS_SMTP_HOST=
# OPS_EMAIL_TO=ops-team@example.com

# Optional SMTP tuning (defaults shown). Port 465 implies implicit TLS;
# anything else uses plain + STARTTLS upgrade when the server advertises it.
# Auth tries AUTH PLAIN first (Gmail) with AUTH LOGIN fallback (Outlook).
# OPS_SMTP_PORT=587
# OPS_SMTP_USER=
# OPS_SMTP_PASS=
# OPS_EMAIL_FROM=barrier-monitor-ops@example.com
# MAIL_USER / MAIL_PASS are accepted as aliases for OPS_SMTP_USER/PASS.
#
# Gmail preset (needs a 16-char App Password, 2FA on; From must equal user):
# OPS_SMTP_HOST=smtp.gmail.com
# OPS_SMTP_PORT=587
# OPS_SMTP_USER=you@gmail.com
# OPS_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# OPS_EMAIL_FROM=you@gmail.com
#
# Outlook / Microsoft 365 preset (SMTP AUTH must be enabled on the mailbox):
# OPS_SMTP_HOST=smtp.office365.com
# OPS_SMTP_PORT=587
# OPS_SMTP_USER=you@outlook.com
# OPS_SMTP_PASS=<app password or account password>

# ══════════════════════════════════════════════════════════════════════════
# ALERT DIGEST — scheduled delivery loop (compose `alerts` service)
# ══════════════════════════════════════════════════════════════════════════

# Pause between digest cycles in seconds (minimum 60). Each cycle detects
# new urgent transitions since the watermark, enqueues idempotently and
# sends one digest per active recipient (same as alerts:check --apply).
# The one-shot stays available for manual runs: deno task alerts:check --apply
# ALERTS_POLL_SECONDS=900

# Poll loop (scripts/fracttal-poll.ts) tuning: pause between cycles in
# seconds (minimum 5). Each cycle sweeps the whole equipment set unfiltered
# (server-side station scoping does not exist - location_code values are
# group/asset tags; stations partition client-side) plus one shared work
# pass; the next cycle chains after completion, so the effective period is
# cycle + pause. Env only — no flags. A full cycle moves ~200 requests in
# ~1-2 minutes, so the default 300 gives roughly 6-8 min freshness. See
# docs/FRACTTAL.md "Sync service" for the math.
# FRACTTAL_POLL_SECONDS=300
# FRACTTAL_SYNC_ITEM_TYPE=2
# Item pages fetched per cycle (100 rows each). The tenant holds ~18k
# equipment today - a sweep needing more aborts loudly instead of deleting,
# raise and rerun, never bypass.
# FRACTTAL_SYNC_MAX_PAGES=200
# Newest work pages per endpoint per cycle (100 rows each, fetched once per
# cycle and shared) - unless FRACTTAL_WORK_OPEN_ONLY sweeps each open
# ot_status to completion instead. Truncation only narrows the recency
# window - it never deletes - and is logged as a warning; raise it when the
# warning repeats.
# FRACTTAL_SYNC_WORK_MAX_PAGES=5
# Sustained request rate for every Fracttal call the poller and the sync CLI
# make (token bucket shared across parallel page fetches). Default 150 sits
# at 75% of the 200 req/min/IP ceiling: margin for token refreshes, retries,
# manual scripts, and NAT-shared egress. Lower it if 406s appear in logs.
# FRACTTAL_RATE_PER_MIN=150
# Parallel page fetches (reassembled in page order, rate-capped above).
# Raise only together with headroom in the rate above.
# FRACTTAL_FETCH_CONCURRENCY=4
# Open-only work pass: sweep each open ot_status (1 in process, 2 review) to
# completion within the item page cap, so old open work stays visible every
# cycle (default on - verified live 2026-09-20: the newest window missed 71%
# of status-affecting open work). Set 0 for the newest window instead.
# FRACTTAL_WORK_OPEN_ONLY=1
