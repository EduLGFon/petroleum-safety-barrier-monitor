{
  // Barrier monitor - Deno-only config (Fresh 2 + Deno-native libs).
  // Single source of truth: tasks, import map, TS, lint and fmt live here.
  // No package.json / tsconfig.json / next.config.mjs - all removed.
  "name": "barrier-monitor",
  "version": "0.4.0",
  "exports": "./main.ts",
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check main.ts routes/api/*.ts routes/api/*/*.ts routes/api/*/*/*.ts routes/auth/*/*.ts routes/auth/*/*/*.ts scripts/*.ts && deno run --allow-read=db/schema.sql scripts/check-migration-order.ts",
    "test": "deno test --allow-read=scripts/fixtures,db/schema.sql --allow-net=127.0.0.1,localhost --allow-env=OPS_SMTP_HOST,OPS_SMTP_PORT,OPS_SMTP_USER,OPS_SMTP_PASS,OPS_EMAIL_TO,OPS_EMAIL_FROM,MAIL_HOST,MAIL_USER,MAIL_PASS,DATABASE_URL .",
    "dev": "vite",
    "build": "vite build",
    "preview": "deno serve -A --port 8300 _fresh/server.js",
    "start": "deno serve --env-file=.env -A --port 8300 _fresh/server.js",
    "start:alt": "deno serve --env-file=.env -A --port 8301 _fresh/server.js",
    "db:migrate": "deno run -A --env-file=.env scripts/migrate.ts",
    "db:seed": "deno run -A --env-file=.env scripts/seed.ts",
    "browser:capture": "deno run -A scripts/browser-capture.ts",
    "docker:build": "docker compose build --provenance=false --sbom=false",
    "docker": "docker compose run --rm tools",
    "docker:up": "docker compose build --provenance=false --sbom=false && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f compose.yml -f compose.dev.yml build --provenance=false --sbom=false && docker compose -f compose.yml -f compose.dev.yml up",
    "docker:dev-down": "docker compose -f compose.yml -f compose.dev.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "deno task docker deno run -A --env-file=.env scripts/migrate.ts",
    "docker:audit": "deno task docker deno run -A --env-file=.env scripts/fracttal-audit-stations.ts",
    "docker:sync": "deno task docker deno run -A --env-file=.env scripts/fracttal-sync.ts --live",
    "docker:force-sync": "deno task docker deno run -A --env-file=.env scripts/fracttal-force-sync.ts",
    "docker:adcre": "deno task docker deno run -A scripts/create-admin.ts",
    "import:users": "deno run -A --env-file=.env scripts/import-users.ts",
    "fracttal:import": "deno run -A --env-file=.env scripts/fracttal-import.ts",
    "fracttal:sync": "deno run -A --env-file=.env scripts/fracttal-sync.ts",
    "fracttal:force-sync": "deno run -A --env-file=.env scripts/fracttal-force-sync.ts",
    "fracttal:poll": "deno run -A --env-file=.env scripts/fracttal-poll.ts",
    "fracttal:audit": "deno run -A --env-file=.env scripts/fracttal-audit-stations.ts",
    "fracttal:capture": "deno run -A scripts/fracttal-capture.ts",
    "fracttal:extract": "deno run -A scripts/fracttal-extract.ts",
    "alerts:check": "deno run -A --env-file=.env scripts/alerts-check.ts",
    "alerts:poll": "deno run -A --env-file=.env scripts/alerts-poll.ts",
    "alerts:provider-check": "deno run -A --env-file=.env scripts/alerts-provider-check.ts",
    "admin:create": "deno run -A --env-file=.env scripts/create-admin.ts",
    "doctor": "deno run -A --env-file=.env scripts/doctor.ts"
  },
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "@preact/signals": "npm:@preact/signals@^2.11.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "xlsx": "npm:xlsx@0.18.5",
    "linkedom": "npm:linkedom@^0.18.13",
    "openid-client": "npm:openid-client@6.8.8"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      "**/_fresh/*",
      "node_modules",
      ".next"
    ]
  },
  "exclude": [
    "**/_fresh/*",
    "node_modules",
    ".next",
    "out",
    "build",
    "dist"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
