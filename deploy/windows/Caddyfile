# Caddy reverse proxy for Barrier Monitor on Windows Server.
# This is why it exists: `deno serve` speaks plain HTTP on :8300 and the
# session cookie only sets Secure over https, so production must terminate
# TLS in front (see docs/PORT-MAP.md finding 11.3). Caddy is a single
# Windows exe with automatic HTTPS; the IIS alternative is documented in
# docs/DEPLOY-WINDOWS.md for shops that already run IIS.
#
# Usage:
#   1. Set the public hostname below (no trailing slash, matches APP_BASE_URL).
#   2. caddy run --config C:\srv\barrier-monitor\deploy\windows\Caddyfile
#   3. Keep TCP 80+443 open; close :8300 to the outside (loopback only).

barreiras.example.com {
	# Dashboard + API on the same origin (no CORS needed). The app trusts
	# X-Real-IP only from this loopback proxy, so each client keeps its own
	# throttle bucket instead of sharing one global bucket.
	reverse_proxy 127.0.0.1:8300 {
		header_up X-Real-IP {remote_host}
	}

	# Same-origin by design: never add Access-Control-Allow-Origin here.
	# X-Forwarded-For stays untrusted; only the loopback proxy's X-Real-IP
	# is accepted by lib/server/throttle.ts.

	header {
		# Hardening without breaking Preact hydration or export downloads.
		# -Server strips the Server: Caddy banner (less fingerprinting);
		# uncomment HSTS only after the first successful https smoke test
		# (enabling it before TLS works bricks plain-HTTP clients for a year).
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# HSTS only after first successful https smoke test.
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output file C:\srv\barrier-monitor\logs\caddy-access.log
		format json
	}
}
